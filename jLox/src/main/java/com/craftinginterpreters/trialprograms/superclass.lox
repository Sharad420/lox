class Doughnut {
  cook() {
    print "Fry until golden brown.";
  }
}

class BostonCream < Doughnut {}

BostonCream().cook();


class A {
  method() {
    print "A method";
    print this.str;
  }
}

class B < A {
  method() {
    print "B method";
  }

  test() {
    super.method();
  }
}

class C < B {}


var instA = A();
var instC = C();
instC.str = "Cstr";
instA.str = "Astr";
instC.test(); // What should it return?