fun vector(x, y) {
    fun getX() {
        return x;
    }

    fun getY() {
        return y;
    }

    fun add(other) {
        return vector(
            x + other("x")(),
            y + other("y")()
        );
    }

    fun dispatch(method) {
        if (method == "x") return getX;
        if (method == "y") return getY;
        if (method == "add") return add;
    }

    return dispatch;
}

var v1 = vector(3, 4);
var v2 = vector(1, 2);

print v1("x")();
print v2("y")();

var v3 = v1("add")(v2);

print v3("x")();
print v3("y")();

// Fucking brilliant.