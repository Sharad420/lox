fun outer() {
  var x = "outer";
  fun inner() {
    print x;
  }
  return inner;
}
var closure = outer();

fun anotherFunction() {
    var a = "A";
    var b = "B";
    var c = "C";

    print a;
    print b;
    print c;
}

anotherFunction();

closure();


{
  var function;
  var scopeVar = 20;
  {
    fun scopeVarusage() {
      fun printVar() {
        print scopeVar;
      }
      return printVar;
    }
    scopeVar = 50;
    function = scopeVarusage();
  }
  function();
}


